{
  "name": "ticktock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cypress:open": "node scripts/run-cypress.mjs open",
    "cypress:run": "node scripts/run-cypress.mjs run",
    "test:e2e": "npm run build && start-server-and-test \"next start --port 3100\" http://localhost:3100 \"node scripts/run-cypress.mjs run --config baseUrl=http://localhost:3100\""
  },
  "dependencies": {
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^14.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "start-server-and-test": "^3.0.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
